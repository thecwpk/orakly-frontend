# =============================================================================
# Orakly web — environment template
# -----------------------------------------------------------------------------
# LOCAL:  copy →  .env.local   (gitignored)   then fill values
# VERCEL: Project → Settings → Environment Variables → add same keys (Production)
# =============================================================================

# --- Database (Railway Postgres — paste full URL from Railway dashboard) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST.railway.app:5432/railway?sslmode=require

# --- Public URLs (no trailing slash) ---
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app

# --- WalletConnect (https://cloud.walletconnect.com → Project ID) ---
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Cron jobs (/api/internal/cron/*) — Vercel sends: Authorization: Bearer <CRON_SECRET> ---
CRON_SECRET=change-me-to-a-long-random-secret-min-32-chars

# --- Cron self-fetch (warm-markets-cache) — usually same origin as production site ---
INTERNAL_APP_URL=https://your-project.vercel.app

# --- Wallet auth cookies (long random; do not reuse CRON_SECRET) ---
WALLET_SESSION_SECRET=change-me-to-a-long-random-secret-min-32-chars

# --- Optional: admin console ---
ADMIN_SESSION_SECRET=
ADMIN_API_TOKEN=

# --- Optional: on-demand revalidate (/api/internal/revalidate-feed) ---
VERCEL_REVALIDATE_SECRET=

# --- Optional: news (/api/v1/news) — use one of these ---
NEWSAPI_KEY=
# NEWSAPI_ORG_KEY=

# --- Optional: Socket.IO in browser (wss://... if you host realtime) ---
NEXT_PUBLIC_REALTIME_URL=

# --- Optional: server realtime ingest (notify helpers) ---
REALTIME_INGEST_URL=
REALTIME_INGEST_SECRET=

# --- Optional: BNB testnet / chain UI ---
NEXT_PUBLIC_TBNB_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
NEXT_PUBLIC_CHAIN_MARKET_TRADE_ADDRESS=
NEXT_PUBLIC_TRADING_USER_ID=

# --- If Railway already runs these jobs, set false on Vercel to avoid duplicates ---
VERCEL_CRON_TRENDING_ENABLED=true
VERCEL_CRON_INGEST_ENABLED=true

# --- Wallet on-chain sync cron (see src/server/wallet-onchain/config.ts) ---
WALLET_ONCHAIN_RPC_URL=
WALLET_ONCHAIN_CHAIN_ID=97
# CSV: 0xToken:SYMBOL:18,0xOther:ABC:6
WALLET_ONCHAIN_TOKENS=
WALLET_ONCHAIN_NATIVE_SYMBOL=tBNB
WALLET_ONCHAIN_NATIVE_DECIMALS=18
WALLET_ONCHAIN_MIN_SYNC_INTERVAL_MS=25000
WALLET_ONCHAIN_CRON_ENABLED=false
WALLET_ONCHAIN_CRON_BATCH_SIZE=12
WALLET_ONCHAIN_CRON_STALE_MS=120000

# --- Chain indexer cron (see src/server/chain-indexer/config.ts) ---
CHAIN_INDEXER_RPC_URL=
# Comma-separated contract addresses
CHAIN_INDEXER_CONTRACT_ADDRESSES=

# --- Platform liquidity user (internal) ---
PLATFORM_LIQUIDITY_USER_ID=

# --- Dev only (ignored in production for TRADING_DEBUG_USER_ID) ---
# TRADING_DEBUG_USER_ID=
