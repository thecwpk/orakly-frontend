# =============================================================================
# Orakly web — environment template
# -----------------------------------------------------------------------------
# LOCAL:  copy →  .env.local   (gitignored)   then fill values
# VERCEL: Project → Settings → Environment Variables → add same keys (Production)
# =============================================================================
#
# Railway = Postgres + worker + realtime. Vercel = Next.js (no GitHub backend clone needed).
# Vercel: DATABASE_URL from Railway Postgres, APP_URL, wallet secrets, chain vars.
# Paste file: apps/web/env.vercel.generated
# =============================================================================

# --- Database (Railway Postgres) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST.railway.app:5432/railway?sslmode=require

# --- Public URLs (no trailing slash) ---
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app
INTERNAL_APP_URL=https://your-project.vercel.app

# Optional hub: Breaking rail prefers 24h odds movers when snapshots exist (cron: sample-market-odds-snapshots)
# NEXT_PUBLIC_HUB_MOVERS_RANKING=true

# --- Auth & cron secrets (npm run env:generate — or copy from apps/web/.env.local) ---
WALLET_SESSION_SECRET=
CRON_SECRET=

# --- BNB Smart Chain testnet (Chapel, chain id 97) ---
# WalletConnect: https://cloud.reown.com — add your site URL to project Allowlist
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=5e858fceaadb5773ae641adf69411b00
NEXT_PUBLIC_SUPPORTED_CHAIN_IDS=97

# RPC — one URL is enough; app also accepts NEXT_PUBLIC_TBNB_RPC_URL or BSC_TESTNET_RPC_URL
NEXT_PUBLIC_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545

NEXT_PUBLIC_FACTORY_ADDRESS=0x180532197f84701e5e183ccbd2f66ea52982dbb2
NEXT_PUBLIC_FACTORY_DEPLOY_BLOCK=101795053
NEXT_PUBLIC_COLLATERAL_ADDRESS=0xf327c48b8acf444311938bf380a26fddb48bb67d
NEXT_PUBLIC_COLLATERAL_DECIMALS=6
NEXT_PUBLIC_TREASURY_ADDRESS=0xA5c5814BA8F5a3926513fD78DDb0968711Ebe8D4
NEXT_PUBLIC_UMA_OPTIMISTIC_ORACLE_V3=0x911a78b32c66261bff31b01a122b4f1e2df8da51
NEXT_PUBLIC_ADMIN_ADDRESSES=0xA5c5814BA8F5a3926513fD78DDb0968711Ebe8D4
NEXT_PUBLIC_BSC_TESTNET_USDC_FAUCET_URL=https://www.bnbchain.org/en/testnet-faucet

# Only if buyOutcomeShares lives on a different contract than the factory
NEXT_PUBLIC_CHAIN_MARKET_TRADE_ADDRESS=

# --- Admin console (optional; generated with env:generate) ---
ADMIN_SESSION_SECRET=
ADMIN_API_TOKEN=
VERCEL_REVALIDATE_SECRET=

# --- Optional: news (/api/v1/news) ---
NEWSAPI_KEY=
# NEWSAPI_ORG_KEY=

# --- Railway realtime service (Socket.IO + trade ingest) ---
# Option A — direct (set ALLOWED_ORIGINS on Railway to your Vercel URL):
# NEXT_PUBLIC_REALTIME_URL=https://YOUR-REALTIME.up.railway.app
# REALTIME_INGEST_URL=https://YOUR-REALTIME.up.railway.app
#
# Option B — same-origin proxy (avoids CORS; browser hits your Vercel domain):
# REALTIME_UPSTREAM_URL=https://YOUR-REALTIME.up.railway.app
# NEXT_PUBLIC_REALTIME_SAME_ORIGIN=true
# REALTIME_INGEST_URL=https://YOUR-REALTIME.up.railway.app
NEXT_PUBLIC_REALTIME_URL=
REALTIME_UPSTREAM_URL=
NEXT_PUBLIC_REALTIME_SAME_ORIGIN=
REALTIME_INGEST_URL=
REALTIME_INGEST_SECRET=

# --- Optional: dev trading header (not used in production) ---
NEXT_PUBLIC_TRADING_USER_ID=

# --- Cron toggles (false when Railway worker handles ingest/trending) ---
VERCEL_CRON_TRENDING_ENABLED=false
VERCEL_CRON_INGEST_ENABLED=false

# --- Wallet on-chain sync (see src/server/wallet-onchain/config.ts) ---
# Uses NEXT_PUBLIC_RPC_URL + NEXT_PUBLIC_COLLATERAL_* when WALLET_ONCHAIN_TOKENS is empty
WALLET_ONCHAIN_RPC_URL=
WALLET_ONCHAIN_CHAIN_ID=97
WALLET_ONCHAIN_TOKENS=
WALLET_ONCHAIN_NATIVE_SYMBOL=tBNB
WALLET_ONCHAIN_NATIVE_DECIMALS=18
WALLET_ONCHAIN_MIN_SYNC_INTERVAL_MS=25000
WALLET_ONCHAIN_CRON_ENABLED=false
WALLET_ONCHAIN_CRON_BATCH_SIZE=12
WALLET_ONCHAIN_CRON_STALE_MS=120000

# --- Chain indexer (see src/server/chain-indexer/config.ts) ---
# Uses NEXT_PUBLIC_RPC_URL + NEXT_PUBLIC_FACTORY_ADDRESS when unset below
CHAIN_INDEXER_ENABLED=false
CHAIN_INDEXER_RPC_URL=
CHAIN_INDEXER_CONTRACT_ADDRESSES=

# --- Platform liquidity user (internal) ---
PLATFORM_LIQUIDITY_USER_ID=

# --- Dev only ---
# TRADING_DEBUG_USER_ID=
