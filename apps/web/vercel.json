{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && npm install",
  "buildCommand": "cd ../.. && npm run db:generate && npm run build --workspace=web",
  "env": {
    "NEXT_PUBLIC_APP_URL": "https://orakly-frontend-web.vercel.app",
    "INTERNAL_APP_URL": "https://orakly-frontend-web.vercel.app",
    "ORAKLY_VERCEL_ONLY": "true",
    "NEXT_PUBLIC_ORAKLY_VERCEL_ONLY": "true",
    "VERCEL_CRON_INGEST_ENABLED": "true",
    "VERCEL_CRON_TRENDING_ENABLED": "true"
  },
  "crons": [
    {
      "path": "/api/internal/cron/worker-bundle",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/internal/cron/warm-markets-cache",
      "schedule": "0 18 * * *"
    }
  ]
}
