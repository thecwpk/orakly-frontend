{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && npm install",
  "buildCommand": "cd ../.. && npm run db:generate && npm run build --workspace=web",
  "env": {
    "NEXT_PUBLIC_APP_URL": "https://orakly-frontend-web.vercel.app",
    "INTERNAL_APP_URL": "https://orakly-frontend-web.vercel.app",
    "NEXT_PUBLIC_REALTIME_SAME_ORIGIN": "true",
    "REALTIME_UPSTREAM_URL": "https://realtime-production-e37e.up.railway.app",
    "REALTIME_INGEST_URL": "https://realtime-production-e37e.up.railway.app"
  },
  "crons": [
    {
      "path": "/api/internal/cron/sample-market-odds-snapshots",
      "schedule": "0 12 * * *"
    }
  ]
}
