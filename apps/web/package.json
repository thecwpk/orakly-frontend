{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "node --input-type=module -e \"import { existsSync, rmSync } from 'node:fs'; if (existsSync('.next')) rmSync('.next',{recursive:true});\"",
    "dev": "next dev --port 3000",
    "dev:clean": "npm run clean && next dev --port 3000",
    "dev:turbo": "next dev --port 3000 --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "check-types": "next typegen && tsc --noEmit",
    "env:generate": "node scripts/generate-env-secrets.mjs"
  },
