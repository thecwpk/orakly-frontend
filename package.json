{
  "name": "orakly-frontend",
  "private": true,
  "packageManager": "npm@11.13.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "db:generate": "npm run db:generate --workspace=@orakly/database && node ./scripts/sync-prisma-client.mjs",
    "bootstrap:dev": "npm run bootstrap:dev --workspace=web",
    "verify:vercel": "npm run verify:vercel --workspace=web",
    "postinstall": "node ./scripts/sync-prisma-client.mjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "eslint": "^10.3.0",
    "prettier": "^3.8.3",
    "turbo": "^2.9.12",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": "20.x"
  }
}
